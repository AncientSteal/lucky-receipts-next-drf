# Django Settings
SECRET_KEY="django-your-secret-key-here"
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,backend

# Database Settings
DB_NAME=lucky_promo
DB_USER=postgres
DB_PASSWORD=postgres

# Promo Action Settings (YYYY-MM-DD)
START_DATE=2026-09-01
END_DATE=2026-10-31

# Для Docker-сервера Next.js (контейнер фронта -> контейнер бэка)
NEXT_SERVER_API_URL=http://backend:8000/api

# Для браузера (компьютер -> Docker бэкенда)
NEXT_PUBLIC_API_URL=http://localhost:8000/api